// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  audios        Audio[]
  likedTracks   Like[]
  username           String?
  displayUsername    String?
  firstName String? @map("first_name")
  lastName String? @map("last_name")
  city String?
  country String?
  bio String? @db.Text
  audioPlays         AudioPlay[]
  comments           Comment[]
  commentLikes       CommentLike[]
  reposts            Repost[]
  listeningHistories ListeningHistory[]
  playlists          Playlist[]
  playlistLikes      PlaylistLike[]
  following    Follow[]  @relation("UserFollowing")
  followers    Follow[]  @relation("UserFollowers")

  @@unique([email])
  @@unique([username])
  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId, token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  audioId   String   @map("audio_id")
  audio     Audio    @relation(fields: [audioId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("tag")
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  audio     Audio[]

  @@index([name])
  @@map("genre")
}

model Audio {
  id                 String             @id @default(cuid())
  artist             String?
  title              String
  slug               String             @unique
  description        String?            @db.Text
  duration           Int                @default(0)
  userId             String             @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags               Tag[]
  genreId            String             @map("genre_id")
  genre              Genre              @relation(fields: [genreId], references: [id])
  audioFile          AudioFile?
  coverFile          CoverFile?
  likes              Like[]
  likesCount         Int                @default(0) @map("likes_count")
  playsCount         Int                @default(0) @map("plays_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  audioPlays         AudioPlay[]
  commentsCount      Int                @default(0)
  comments           Comment[]
  repostsCount       Int                @default(0)
  reposts            Repost[]
  listeningHistories ListeningHistory[]
  playlistAudios     PlaylistAudio[]

  @@index([duration, slug, likesCount])
  @@map("audio")
}

model AudioFile {
  id        String   @id @default(cuid())
  url       String
  format    String?
  size      Int? // bytes
  audioId   String   @unique @map("audio_id")
  audio     Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audio_file")
}

model CoverFile {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  audioId   String   @unique @map("audio_id")
  audio     Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cover_file")
}

model Like {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioId   String   @map("audio_id")
  audio     Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, audioId])
  @@map("like")
}

model AudioPlay {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioId  String   @map("audio_id")
  audio    Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now()) @map("played_at")

  @@unique([userId, audioId, playedAt])
  @@map("audio_play")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  timestamp  Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  likesCount Int      @default(0) @map("likes_count")

  audioId      String        @map("audio_id")
  audio        Audio         @relation(fields: [audioId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId     String?       @map("parent_id")
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@index([audioId, timestamp, parentId, userId])
  @@map("comment")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_like")
}

model Repost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  audioId String @map("audio_id")
  audio   Audio  @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([userId, audioId])
  @@map("repost")
}

model ListeningHistory {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioId    String   @map("audio_id")
  audio      Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  listenedAt DateTime @default(now()) @map("listened_at")

  @@id([userId, audioId])
  @@index([listenedAt, userId])
  @@map("listening_history")
}

enum PlaylistTypeEnum {
  public
  private
}

model Playlist {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  description       String?            @db.Text
  type              PlaylistTypeEnum   @default(public)
  userId            String             @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  audios            PlaylistAudio[]
  audioCount        Int                @default(0) @map("audio_count")
  likes             PlaylistLike[]
  likeCount         Int                @default(0) @map("like_count")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  playlistCoverFile PlaylistCoverFile?

  @@map("playlist")
}

model PlaylistCoverFile {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  playlistId String   @unique @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("playlist_cover_file")
}

model PlaylistAudio {
  id         String   @id @default(cuid())
  playlistId String   @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  audioId    String   @map("audio_id")
  audio      Audio    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now()) @map("added_at")

  @@unique([playlistId, audioId])
  @@map("playlist_audio")
}

model PlaylistLike {
  id         String   @id @default(cuid())
  playlistId String   @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([playlistId, userId])
  @@map("playlist_like")
}


model Follow {
  id String @id @default(cuid())
  followerId String @map("followed_id")
  followingId String @map("following_id")
  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@map("follow")
}
